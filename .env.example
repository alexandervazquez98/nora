# NORA — sanitized runtime configuration template.
#
# Copy this file to `.env` and replace the placeholders before booting NORA.
# NEVER commit `.env`; it is gitignored. NEVER put a real credential in
# `.env.example`; this file is the public reference of every key NORA reads.

# --- Provider selection ------------------------------------------------------
# NORA_LLM_PROVIDER picks which provider boots at startup. Switching needs a
# restart; the server logs the active provider on boot.
NORA_LLM_PROVIDER=lmstudio

# --- LM Studio (local inference) --------------------------------------------
# Host:port of the LM Studio local API server. Default works for a stock
# local install; change if your LM Studio listens elsewhere.
LMSTUDIO_API_HOST=localhost:1234
# A model identifier loaded into LM Studio. Example names below are
# placeholders — pick whatever your local install exposes.
LMSTUDIO_MODEL_ID=change-me

# --- Google Gemini (cloud inference) -----------------------------------------
# API key for Google GenAI. Get one at the Google AI Studio; required only
# when NORA_LLM_PROVIDER=gemini.
GEMINI_API_KEY=change-me
# Gemini model identifier. Examples: gemini-2.5-flash, gemini-2.5-pro.
GEMINI_MODEL_ID=gemini-2.5-flash

# --- SessionJournal (Phase 2) ------------------------------------------------
# Directory holding per-session canonical JSON files. Created at boot if
# missing. Operator-owned path; avoid shared/network mounts.
NORA_SESSION_JOURNAL_DIR=./var/sessions/
# Cap on in-memory trace length before oldest steps are displaced to NDJSON.
NORA_SESSION_TRACE_MAX_STEPS=50
# Operator-controlled opt-out: "false" disables auto-trace AND the explicit
# session tools (the latter raise JournalDisabledError).
NORA_SESSION_JOURNAL_ENABLED=true
# Operator alias recorded on every session. ≤ 64 chars; sanitized placeholder.
NORA_OPERATOR_ALIAS=anonymous
