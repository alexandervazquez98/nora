# NORA — sanitized runtime configuration template.
#
# Copy this file to `.env` and replace the placeholders before booting NORA.
# NEVER commit `.env`; it is gitignored. NEVER put a real credential in
# `.env.example`; this file is the public reference of every key NORA reads.

# --- Provider selection ------------------------------------------------------
# NORA_LLM_PROVIDER picks which provider boots at startup. Switching needs a
# restart; the server logs the active provider on boot.
NORA_LLM_PROVIDER=lmstudio

# --- LM Studio (local inference) --------------------------------------------
# Host:port of the LM Studio local API server. Default works for a stock
# local install; change if your LM Studio listens elsewhere.
LMSTUDIO_API_HOST=localhost:1234
# A model identifier loaded into LM Studio. Example names below are
# placeholders — pick whatever your local install exposes.
LMSTUDIO_MODEL_ID=change-me

# --- Google Gemini (cloud inference) -----------------------------------------
# API key for Google GenAI. Get one at the Google AI Studio; required only
# when NORA_LLM_PROVIDER=gemini.
GEMINI_API_KEY=change-me
# Gemini model identifier. Examples: gemini-2.5-flash, gemini-2.5-pro.
GEMINI_MODEL_ID=gemini-2.5-flash

# --- SessionJournal (Phase 2) ------------------------------------------------
# Directory holding per-session canonical JSON files. Created at boot if
# missing. Operator-owned path; avoid shared/network mounts.
NORA_SESSION_JOURNAL_DIR=./var/sessions/
# Cap on in-memory trace length before oldest steps are displaced to NDJSON.
NORA_SESSION_TRACE_MAX_STEPS=50
# Operator-controlled opt-out: "false" disables auto-trace AND the explicit
# session tools (the latter raise JournalDisabledError).
NORA_SESSION_JOURNAL_ENABLED=true
# Operator alias recorded on every session. ≤ 64 chars; sanitized placeholder.
NORA_OPERATOR_ALIAS=anonymous

# --- Driver layer (Phase 2 — PMP 450i SNMP driver) ---------------------------
# Directory holding per-vendor/per-firmware OID catalog JSON files.
# Layout: <path>/<vendor>/<model>/<firmware>.json. Defaults to ./data/oid-catalogs/.
NORA_OID_CATALOGS_PATH=./data/oid-catalogs/
# YAML inventory file the driver loads on boot. Public example lives at
# data/devices.example.yaml (RFC 5737 placeholder + change-me credentials).
NORA_DEVICES_INVENTORY_PATH=./data/devices.yaml
# HMAC-SHA256 key for catalog file verification. Empty / unset values cause
# OidCatalogRegistry.verify_all to fail closed with CatalogVerificationError.
NORA_OID_CATALOG_SIGNING_KEY=change-me
# Optional override directory for system prompts. When unset, NORA reads the
# packaged prompts under src/nora/prompts/. Operators can drop .md files
# (with valid YAML front-matter) here to override without editing the wheel.
NORA_PROMPTS_DIR=

# --- Intervention memory MCP (Phase 3) --------------------------------------
# On-disk directory of intervention JSON records written by openchat's
# intervention_memory_tool. The default is relative (./var/interventions/)
# so no production path enters the repo. The operator wires the real `.22`
# path (e.g., /app/backend/data/interventions in docker, or the host mount)
# in `.env`. NORA never creates this directory — openchat owns it.
NORA_INTERVENTIONS_DIR=./var/interventions/
# Cap on keyword-search I/O. When search_intervention_history is called with
# a `keyword` filter, at most this many files are read; WARNING logged when
# the cap fires.
NORA_INTERVENTIONS_KEYWORD_SEARCH_MAX_RECORDS=1000
# Cap on correlate-scan I/O. correlate_sector_interference walks at most
# this many of the most-recent records.
NORA_INTERVENTIONS_CORRELATE_SCAN_LIMIT=50
