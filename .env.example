# NORA MCP — sanitized runtime configuration template (thin split).
# Copy to `.env` and replace the placeholders before booting NORA.
# NEVER commit `.env`; it is gitignored.

# --- Driver layer (PMP 450i SNMP driver) -----------------------------------
NORA_OID_CATALOGS_PATH=./data/oid-catalogs/
NORA_DEVICES_INVENTORY_PATH=./data/devices.yaml
NORA_OID_CATALOG_SIGNING_KEY=change-me
NORA_PROMPTS_DIR=

# --- Intervention memory MCP (Phase 3) --------------------------------------
NORA_INTERVENTIONS_DIR=./var/interventions/
NORA_INTERVENTIONS_KEYWORD_SEARCH_MAX_RECORDS=1000
NORA_INTERVENTIONS_CORRELATE_SCAN_LIMIT=50

# --- Slice 4 — spectrum sweep + HITL-gated migration (PR 4) ------------------
# Maintenance-window enforcement for ``snmp_run_spectrum_analysis``.
# ``NORA_MAINTENANCE_WINDOW_MINUTES=0`` disables enforcement (the default).
NORA_MAINTENANCE_WINDOW_MINUTES=0
NORA_MAINTENANCE_WINDOW_START_MINUTES_AGO=0
# HITL rollback watchdog — ``threading.Timer`` armed after the AP SET
# frame; default 300s. Tests override to a fraction of a second.
NORA_HITL_ROLLBACK_TIMEOUT_SECONDS=300
# HITL token TTL — default 900s. Setting ``NORA_HITL_TOKEN_TTL_SECONDS=0``
# (the kill switch) makes the stub reject every token.
NORA_HITL_TOKEN_TTL_SECONDS=900
# Issue #43 / `2026-09-15-3tier-tool-governance` — HMAC-SHA256 signing key
# for HITL approval tokens. Required at first Tier-2 invocation
# (`nora hitl mint`); lazy fail-closed when empty. Rotation deferred to
# Phase-3 — see OPERATIONS.md.
NORA_HITL_SIGNING_KEY=change-me
# Issue #43 / `2026-09-15-3tier-tool-governance` — operator-overridable
# tool-spec directory scanned alongside the packaged prompts at boot.
# Defaults to `docs/tool_specs/` (resolved against the process CWD).
NORA_TOOL_SPECS_DIR=docs/tool_specs/
# WU-4 / PR #44 follow-up — gate for the `hitl_mint_token` MCP admin tool.
# Default is True (ON, per user decision 2026-09-17). Set to `false` to
# opt out and force the CLI-only minting path (`nora hitl mint …`).
# Mirrors `Settings.nora_hitl_admin_enabled`.
NORA_HITL_ADMIN_ENABLED=true

# WU-A (feat/multi-community-band-reboot) — pre-flight community
# validation. Default true: ``snmp_migrate_radio_frequency`` runs a
# read-only sysDescr probe against every candidate SM BEFORE the
# HITL gate. Set to false ONLY for legacy test fixtures that pre-date
# the WU-A cut.
NORA_PREFLIGHT_COMMUNITY_VALIDATION=true

# --- Slice 4 — spectrum sweep SET/GET poll (PR 4 / issue #62 WU-3) ---------
# Default sweep duration in seconds. The hard [1, 600] bound is
# enforced by ``Settings._validate_spectrum_sweep_duration_bounds``
# and by the FastMCP tool wiring
# (``snmp_run_spectrum_analysis`` accepts an optional override at
# call time). Default 15s — matches the Cambium WHISP-BOX-MIBV2-MIB
# reference recommendation.
NORA_SPECTRUM_SWEEP_DURATION_SECONDS=15
# Inter-poll interval for the GET-poll loop on ``.221.0``. Default
# 1.0s — mirrors the Cambium WHISP-BOX-MIBV2-MIB recommendation; the
# WU-3 helper defaults to this.
NORA_SPECTRUM_SWEEP_POLL_INTERVAL_SECONDS=1.0
# Hard upper bound on a single sweep (poll loop). Default 60s —
# sweeps longer than this raise ``SpectrumSweepTimeout`` and let the
# orchestrator decide.
NORA_SPECTRUM_SWEEP_TIMEOUT_SECONDS=60
